        cutPage.drawLine({
          start: { x: slotX_pt + p1.x * slotW_pt, y: slotY_pt + (1 - p1.y) * slotH_pt },
          end: { x: slotX_pt + p2.x * slotW_pt, y: slotY_pt + (1 - p2.y) * slotH_pt },
          thickness: 0.25,
          color: rgb(1, 0, 1)
        });
      }
    } else {
      cutPage.drawRectangle({
        x: slotX_pt,
        y: slotY_pt,
        width: slotW_pt,
        height: slotH_pt,
        borderColor: rgb(1, 0, 1),
        borderWidth: 0.25
      });
    }
  });

  const pdfBytes = await outPdf.save();
  const filename = `Impozicija_PrintAndCut_2Psl_${sheetW}x${sheetH}mm.pdf`;
  const blob = new Blob([pdfBytes], { type: 'application/pdf' });

  if (typeof window.triggerRealDownload === 'function') {
    window.triggerRealDownload(blob, filename, 'application/pdf');
  } else {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 500);
  }
};

window.exportPDF = window.downloadImpositionPDF;

// Take initial state snapshot safely
setTimeout(() => {
  if (state.slots && state.slots.length > 0 && state.history.length === 0) {
    window.pushHistoryState('Pradinis lankas');
  }
  window.updateSlotCounter();
}, 400);
