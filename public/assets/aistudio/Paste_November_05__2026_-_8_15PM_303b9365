    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;

    const rawCanvasX = (e.clientX - rect.left) * scaleX;
    const rawCanvasY = (e.clientY - rect.top) * scaleY;

    const zoom = Math.max(0.01, Number(state.zoom) || 1);
    const basePxPerMm = Math.max(0.01, Number(state.pxPerMm) || 1);
    const totalScale = basePxPerMm * zoom;

